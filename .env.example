LOG_LEVEL=DEBUG
LLM_API_ENDPOINT=your_llm_api_here
LLM_API_KEY=your_llm_api_key_here
TRACE_PATH=your trace file path here
HARNY_SANDBOX=sandbox folder
TOOL_TESTER_MODEL=test model
PLANNER_CONSERVATIVE_MODEL=the model for conservative plannig
PLANNER_EXPLORATIVE_MODEL=the model used for a more explorative planning
SELECTOR_MODEL=the model to pick a plan
CRITIC_MODEL=the model used to critique a plan
IMPLEMENTATION_MODEL=the model to write the code
IMPLEMENTATION_FIX_MODEL=the model to fix code in the review loop
REVIEWER_MODEL=the model to review the implementation
GIT_USER_EMAIL=git author email for sandbox commits (default harny@local)
GIT_USER_NAME=git author name for sandbox commits (default Harny)
PR_REVIEWER_MODEL=the model to review the PR (skeptical reviewer that posts comments)
